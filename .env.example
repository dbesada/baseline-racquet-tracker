# Copy to .env and fill in real values. Never commit .env.
# Most secrets can also be supplied as a file path (the *_FILE variables);
# prefer that on servers so the value never sits in an environment listing.

# --- Price checks (scripts/check-prices.mjs) ---
# Base URL of the running app the monitor talks to.
BASELINE_URL=http://localhost:3000
# eBay Browse API credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_CREDENTIALS_FILE=
# Optional data providers.
APIFY_TOKEN=
# APIFY_TOKEN_FILE=
BROWSERLESS_TOKEN=
# BROWSERLESS_TOKEN_FILE=
# BROWSERLESS_PROFILE=
# BROWSERLESS_PROFILE_FILE=
# MARKETPLACE_BROWSER_URL=

# --- Relay (scripts/baseline-relay.mjs) ---
# Cloudflare Access verification. Both come from the Access application in the
# Cloudflare Zero Trust dashboard. While either is empty, admin actions work
# only from the local network.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# eBay marketplace account-deletion callback.
# EBAY_DELETION_TOKEN_FILE=/app/.data/ebay-deletion-token
# EBAY_DELETION_ENDPOINT=

# --- TrueNAS release scripts (scripts/truenas-*.mjs) ---
# TRUENAS_HOST=truenas.besada.net
# TRUENAS_API_KEY_FILE=C:/path/to/truenas-api-key.txt
# The NAS's certificate covers *.besada.net, so use that name, not the LAN IP.
# Only if the certificate cannot be verified, and only on a trusted LAN, set
# this to 1 to skip certificate checks for a single run.
# BASELINE_ALLOW_INSECURE_TLS=0
